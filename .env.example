# Local secrets / OAuth — copy to .env or .env.local (both are gitignored).
# Glider loads these at startup without overriding vars already set in your shell.
#
#   copy .env.example .env.local
#   # edit .env.local, then start Glider from the repo root

# GitHub MCP — browser Sign in (classic OAuth App)
GLIDER_GITHUB_OAUTH_CLIENT_ID=
GLIDER_GITHUB_OAUTH_CLIENT_SECRET=
# Callback URL on the GitHub OAuth App must be exactly:
#   http://127.0.0.1:8081/oauth/callback
# GLIDER_GITHUB_OAUTH_SCOPES=repo read:org read:user
# Optional override:
# GLIDER_GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8081/oauth/callback

# Device Flow alternative (enable "Device Flow" on the app if you use it instead)
# Or skip OAuth and use a PAT (also accepted via MCP tab "Paste PAT")
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=
# GH_TOKEN=

# Web search builtins (web_search / web_fetch) — optional keyed providers.
# With provider: auto (default), Glider tries in order then falls back:
#   Brave → Tavily → SerpAPI → SearXNG → DuckDuckGo HTML (no key).
# Forced provider=brave|tavily|serpapi errors clearly if that env is empty.
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPAPI_KEY=
# SEARXNG_URL=http://127.0.0.1:8080
